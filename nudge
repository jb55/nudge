#!/bin/sh
# nudge: post a macOS notification from Nudge.app.
#
#   nudge --title T --message M [flags...]    (see README.md)
#
# The posting has to happen in Nudge.app's own executable, since macOS ties
# the notification, its icon and its permission to the bundle the process
# runs from. This finds the app and execs it, so the exit status is
# Nudge's: 0 posted, 2 not allowed, 3 failed, 64 usage, 69 app not found.
#
# Where it looks: $NUDGE_APP when set (and nowhere else), otherwise the
# bundle this script lives in (the Homebrew cask links
# Nudge.app/Contents/Resources/nudge onto PATH), then ~/Applications,
# /Applications, then Spotlight by bundle id.
set -eu

# Nudge with no arguments is LaunchServices relaunching it for a click,
# not a post, so a bare `nudge` prints usage instead.
if [ $# -eq 0 ]; then
    echo "usage: nudge --title T --message M [--subtitle S] [--url U] [--image PNG]" >&2
    echo "       [--group G] [--thread T] [--action ID=LABEL]... [--env KEY=VALUE]..." >&2
    echo "       [--avatar PNG [--sender NAME]]       (see README.md)" >&2
    exit 64
fi

bin=Contents/MacOS/Nudge

# find_app: set $app to the Nudge.app to use, or return 1.
find_app() {
    if [ -n "${NUDGE_APP-}" ]; then
        app=$NUDGE_APP
        [ -x "$app/$bin" ] && return 0
        echo "nudge: NUDGE_APP=$NUDGE_APP has no $bin" >&2
        exit 69
    fi
    # Follow symlinks (Homebrew's bin/nudge) to where this script really is.
    self=$0
    while [ -L "$self" ]; do
        link=$(readlink "$self")
        case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
    done
    case $self in
        */Contents/Resources/nudge)
            app=${self%/Contents/Resources/nudge}
            [ -x "$app/$bin" ] && return 0 ;;
    esac
    for app in "$HOME/Applications/Nudge.app" /Applications/Nudge.app; do
        [ -x "$app/$bin" ] && return 0
    done
    app=$(/usr/bin/mdfind 'kMDItemCFBundleIdentifier == "com.jb55.nudge"' 2>/dev/null | head -n 1)
    [ -n "$app" ] && [ -x "$app/$bin" ] && return 0
    return 1
}

if ! find_app; then
    echo "nudge: Nudge.app not found; brew install --cask jb55/nudge/nudge, run ./build.sh, or set NUDGE_APP" >&2
    exit 69
fi

# `nudge --authorize` is the first-run step after an install that didn't run
# build.sh (the Homebrew cask): posting from the bare executable is refused
# until LaunchServices knows the bundle and has launched it once, so
# register it and launch it through LaunchServices, which asks for
# notification permission (only the first time) and exits.
if [ "$*" = --authorize ]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
    exec /usr/bin/open -W -n "$app" --args --authorize
fi

exec "$app/$bin" "$@"
